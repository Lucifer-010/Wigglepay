# ==============================================================================
# WigglePay Global Credentials & Environment Configuration Template (.env.example)
# Duplicate this file to .env and replace placeholder secrets for production.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- DATABASE CONFIGURATION (POSTGRESQL) ---
DATABASE_URL=postgres://wigglepay:wigglepay_secret_password@postgres:5432/wigglepay_db
POSTGRES_DB=wigglepay_db
POSTGRES_USER=wigglepay
POSTGRES_PASSWORD=wigglepay_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USE_SQLITE_FALLBACK=True

# --- CACHE & ASYNC BROKER (REDIS + CELERY) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- STELLAR BLOCKCHAIN SETTLEMENT LAYER ---
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_PLATFORM_PUBLIC_KEY=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_PLATFORM_SECRET_KEY=SBV756ZJ2E3A7M3W2FDEVPLATFORMSECRETDUMMYKEYDO_NOT_LEAK
STELLAR_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_ISSUER_PUBLIC=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
SOROBAN_ESCROW_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# --- AI ENGINE (OLLAMA QWEN3 / FAST-WHISPER) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TELEGRAM BOT INTEGRATION ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_URL=http://localhost:8000/api/v1/telegram/webhook/
TELEGRAM_MINIAPP_URL=http://localhost:3000/?view=miniapp

# --- MERCHANT GATEWAY & WEBHOOK SECURITY ---
WIGGLEPAY_DEFAULT_WEBHOOK_SECRET=wp_whsec_replace_with_strong_secret
WIGGLEPAY_API_KEY_SALT=wp_salt_stellar_settlement_2026
PLATFORM_FEE_BPS=50

# --- PORTS & PUBLIC URLS ---
PORT=8000
CHANNELS_PORT=8001
FRONTEND_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

